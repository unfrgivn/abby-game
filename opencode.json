{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["spec.md", "docs/*.md"],
  "agent": {
    "plan": {
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "mcp": {
    "unity": {
      "type": "remote",
      "url": "http://localhost:9090/mcp"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "mv *": "ask",
      "rm *": "ask"
    }
  }
}
