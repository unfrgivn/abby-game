{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["spec.md", "docs/*.md"],
  "agent": {
    "plan": {
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "mv *": "ask",
      "rm *": "ask"
      "rm -f *.gdkeep": "allow"
    }
  }
}
